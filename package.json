{
  "name": "@wanaguirre/swiss-civic-reports",
  "version": "0.4.0-rc.7",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanaguirre/swiss-civic-reports-connector.git"
  },
  "description": "Shared civic reporting core, MCP server and private Telegram bot for Swiss municipalities.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "zueri-wie-neu-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "scripts/install-codex.mjs",
    "scripts/telegram-identity.mjs",
    "scripts/verify-installation.mjs",
    ".env.example",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs/SETUP.md",
    "CONTRIBUTING.md",
    "docs/DEVELOPMENT.md",
    "docs/ARCHITECTURE.md",
    "docs/ANTHRAZIT.md",
    "docs/MUNICIPAL-FORMS.md"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/cli.js",
    "doctor": "node dist/cli.js doctor",
    "telegram": "node --env-file=.env dist/cli.js telegram",
    "verify:installation": "node scripts/verify-installation.mjs",
    "prepack": "npm run build",
    "format": "prettier --check \"{src,test,scripts}/**/*.{ts,mjs}\" \"*.json\" \".github/workflows/*.yml\"",
    "format:write": "prettier --write \"{src,test,scripts}/**/*.{ts,mjs}\" \"*.json\" \".github/workflows/*.yml\"",
    "check": "npm run format && npm test && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.0",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "parse5": "8.0.0",
    "sharp": "^0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3"
  },
  "private": true,
  "homepage": "https://github.com/wanaguirre/swiss-civic-reports-connector#readme",
  "bugs": {
    "url": "https://github.com/wanaguirre/swiss-civic-reports-connector/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./city": {
      "types": "./dist/city.d.ts",
      "import": "./dist/city.js"
    },
    "./durable-files": {
      "types": "./dist/durable-files.d.ts",
      "import": "./dist/durable-files.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./language": {
      "types": "./dist/language.d.ts",
      "import": "./dist/language.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./photos": {
      "types": "./dist/photos.d.ts",
      "import": "./dist/photos.js"
    },
    "./places": {
      "types": "./dist/places.d.ts",
      "import": "./dist/places.js"
    },
    "./reporting-draft": {
      "types": "./dist/reporting-draft.d.ts",
      "import": "./dist/reporting-draft.js"
    },
    "./reporting-guidance": {
      "types": "./dist/reporting-guidance.d.ts",
      "import": "./dist/reporting-guidance.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./storage-budget": {
      "types": "./dist/storage-budget.d.ts",
      "import": "./dist/storage-budget.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./telegram-api": {
      "types": "./dist/telegram-api.d.ts",
      "import": "./dist/telegram-api.js"
    },
    "./telegram-bot": {
      "types": "./dist/telegram-bot.d.ts",
      "import": "./dist/telegram-bot.js"
    },
    "./telegram-draft": {
      "types": "./dist/telegram-draft.d.ts",
      "import": "./dist/telegram-draft.js"
    },
    "./telegram": {
      "types": "./dist/telegram.d.ts",
      "import": "./dist/telegram.js"
    },
    "./tracking": {
      "types": "./dist/tracking.d.ts",
      "import": "./dist/tracking.js"
    },
    "./run-cli": {
      "types": "./dist/run-cli.d.ts",
      "import": "./dist/run-cli.js"
    },
    "./anthrazit": {
      "types": "./dist/anthrazit.d.ts",
      "import": "./dist/anthrazit.js"
    },
    "./municipalities": {
      "types": "./dist/municipalities.d.ts",
      "import": "./dist/municipalities.js"
    },
    "./municipal-forms": {
      "types": "./dist/municipal-forms.d.ts",
      "import": "./dist/municipal-forms.js"
    }
  }
}
