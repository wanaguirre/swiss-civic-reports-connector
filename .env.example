# Keep this file's real values in .env, ignored by Git. chmod 600 .env
ZURI_ENABLE_SUBMISSION=false
ZURI_TELEGRAM_BOT_TOKEN=
ZURI_TELEGRAM_USER_ID=
ZURI_TELEGRAM_AI=manual
ZURI_REPORT_EMAIL=
ZURI_REPORT_NAME=
ZURI_REPORT_PHONE=
ZURI_CODEX_COMMAND=codex
# Optional dedicated private storage directory:
# ZURI_DATA_DIR=/absolute/private/path
# Optional single-user HTTP mode (use a random token of at least 32 characters):
# ZURI_HTTP_TOKEN=
# ZURI_HOST=127.0.0.1
# ZURI_PORT=3211
